# For local dev: copy this file to .env (vercel dev reads it automatically).
# For deployed environments: set these in Vercel → Project → Settings →
# Environment Variables instead — .env is gitignored and never deployed.

# Stripe secret key (starts with sk_test_ for testing, sk_live_ for real charges).
# Find it at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_51U1Y3g4GhB0xPLUycuAPGMHzVolX19UjCFlromNNts15QWqwAKRZixV5xYeVlESZ2olCoJ6yVj2z8S1z6j4DXhV100wpOlNAw7
# Signing secret for verifying Stripe webhook events.
# Local dev: run `stripe listen --forward-to localhost:3000/api/webhook` and
# copy the whsec_... it prints.
# Deployed: create a webhook endpoint in the Stripe dashboard pointing at
# https://your-project.vercel.app/api/webhook and copy its signing secret.
STRIPE_WEBHOOK_SECRET=whsec_kxwvHuDX2gLKdTfVxoqjq6Owo2D8kPSP

# Optional. Vercel auto-fills the deployment URL (VERCEL_URL) for you, so you
# only need this once you're on a custom domain — set it to that domain then.
PUBLIC_URL=